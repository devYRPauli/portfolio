# While this kit lives inside the portfolio repo, that repo's blanket `*.md`
# rule would silently drop the bot roster, the docs and the installer. This
# undoes it. Harmless once the kit is its own repo - see NEW_REPO.md.
!*.md

# Local state produced by running the kit.
jobs/
log.jsonl
log.jsonl.head
log.jsonl.lock/
*/workspace/
bots/*/memory.md

# Node
node_modules/
dist/
out/

# OS
.DS_Store
