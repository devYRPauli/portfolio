---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkList from '../components/WorkList.astro';
import PostList from '../components/PostList.astro';
import memoji from '../assets/memoji.png';

const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const selectedProjects = projects
  .filter((project) => project.data.featuredOrder !== undefined)
  .sort((a, b) => (a.data.featuredOrder ?? Infinity) - (b.data.featuredOrder ?? Infinity))
  .slice(0, 3);
const posts = (await getCollection('writing'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Yash Raj Pandey',
  image: new URL(memoji.src, Astro.site).href,
  jobTitle: 'AI Agents Architect',
  worksFor: { '@type': 'Organization', name: 'University of Florida IFAS' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University of Florida' },
    { '@type': 'CollegeOrUniversity', name: 'Jaypee University of Engineering and Technology' },
  ],
  knowsAbout: [
    'AI agents',
    'LLM infrastructure',
    'Retrieval-augmented generation',
    'Model evaluation',
    'Developer tools',
  ],
  url: 'https://yashrajpandey.com',
  sameAs: [
    'https://github.com/devYRPauli',
    'https://www.linkedin.com/in/yashrajpandeyy/',
    'https://x.com/I_AM_YRP',
  ],
};
---
<BaseLayout
  title="Yash Raj Pandey - AI Agents Architect"
  description="AI systems engineer building local-first LLM infrastructure, agent platforms, evaluation systems, and developer tools. AI Agents Architect at UF IFAS."
  jsonLd={jsonLd}
>
  <section class="hero">
    <Image
      src={memoji}
      alt="Yash's memoji, waving"
      width={88}
      format="webp"
      quality={85}
      loading="eager"
      fetchpriority="high"
    />
    <h1>Yash Raj Pandey</h1>
    <p class="tagline"><em>AI systems engineer.</em> I build local-first LLM infrastructure, agent platforms, evaluation systems, and developer tools.</p>
    <p class="intro">At UF IFAS, I lead the AI systems function I proposed. I also reproduce new model research, contribute fixes upstream, and write about what broke. Outside work, I follow football and build small tools I want to use myself.</p>
  </section>

  <section id="work" aria-labelledby="work-h">
    <h2 id="work-h" class="section-label">Selected Work</h2>
    <WorkList projects={selectedProjects} />
    <a class="more" href="/work/">All work -&gt;</a>
    <p class="work-note">I also have 45+ pull requests merged across 30+ open-source projects, including llama.cpp, Apple MLX, and Google Research's TabFM. <a href="https://github.com/devYRPauli?tab=pullrequests">See the pull requests</a>.</p>
  </section>

  <section id="writing" aria-labelledby="writing-h">
    <h2 id="writing-h" class="section-label">Writing</h2>
    <PostList posts={posts} />
    <a class="more" href="/writing/">All writing -&gt;</a>
  </section>

</BaseLayout>

<style>
  section { margin-top: var(--space-8); }
  .hero img { border-radius: 20px; }
  .hero h1 { margin-top: var(--space-4); }
  .tagline { font-size: 1.25rem; margin-top: var(--space-2); }
  .tagline em { font-family: var(--font-serif); font-style: italic; font-size: 1.15em; }
  .intro { color: var(--ink-soft); margin-top: var(--space-4); }
  .section-label { margin-bottom: var(--space-4); }
  .more { display: inline-block; margin-top: var(--space-3); font-size: 0.9375rem; }
  .work-note { color: var(--ink-soft); font-size: 0.9375rem; margin-top: var(--space-5); }
</style>
