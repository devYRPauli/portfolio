---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import memoji from '../assets/memoji.png';
import { totals } from '../data/contributions';
import { postMeta } from '../lib/reading';

const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const selectedProjects = projects
  .filter((project) => project.data.featuredOrder !== undefined)
  .sort((a, b) => (a.data.featuredOrder ?? Infinity) - (b.data.featuredOrder ?? Infinity))
  .slice(0, 3);
const allPosts = (await getCollection('writing'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const posts = allPosts.slice(0, 3);

const workEntries = selectedProjects.map((p) => ({
  href: `/work/${p.id}/`,
  title: p.data.title,
  meta: [p.data.kind, p.data.year],
  summary: p.data.summary,
  transitionName: `work-${p.id}`,
}));

const postEntries = posts.map((p) => ({
  href: `/writing/${p.id}/`,
  title: p.data.title,
  meta: postMeta(p.data.pubDate, p.body),
  summary: p.data.description,
  transitionName: `post-${p.id}`,
}));

const record = [
  { figure: `${totals.merged}`, label: 'pull requests merged', href: '/contributions/' },
  { figure: `${totals.projects}`, label: 'projects contributed to', href: '/contributions/' },
  { figure: `${projects.length}`, label: 'case studies', href: '/work/' },
  { figure: `${allPosts.length}`, label: 'writeups', href: '/writing/' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Yash Raj Pandey',
  image: new URL(memoji.src, Astro.site).href,
  jobTitle: 'AI Agents Architect',
  worksFor: { '@type': 'Organization', name: 'University of Florida IFAS' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University of Florida' },
    { '@type': 'CollegeOrUniversity', name: 'Jaypee University of Engineering and Technology' },
  ],
  knowsAbout: [
    'AI agents',
    'LLM infrastructure',
    'Retrieval-augmented generation',
    'Model evaluation',
    'Developer tools',
  ],
  url: 'https://yashrajpandey.com',
  sameAs: [
    'https://github.com/devYRPauli',
    'https://www.linkedin.com/in/yashrajpandeyy/',
    'https://x.com/devYRPauli',
  ],
};
---
<BaseLayout
  title="Yash Raj Pandey - AI Agents Architect"
  description="AI systems engineer building local-first LLM infrastructure, agent platforms, evaluation systems, and developer tools. AI Agents Architect at UF IFAS."
  jsonLd={jsonLd}
>
  <section class="hero">
    <Image
      src={memoji}
      alt="Yash's memoji, waving"
      width={80}
      densities={[1, 2]}
      format="webp"
      quality={85}
      loading="eager"
      fetchpriority="high"
    />
    <p class="eyebrow">AI Systems Engineer</p>
    <h1 class="display-xl">Yash Raj Pandey</h1>
    <p class="tagline">
      I build local-first LLM infrastructure, agent platforms, evaluation systems, and developer tools.
    </p>
    <p class="intro">
      I reproduce new model research, publish what broke, and send the fixes upstream.
    </p>

    <ul class="record">
      {record.map((r) => (
        <li>
          <a href={r.href}>
            <span class="figure">{r.figure}</span>
            <span class="label">{r.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="work" aria-labelledby="work-h">
    <h2 id="work-h" class="eyebrow">
      Selected Work<span class="rule" aria-hidden="true">/</span><span class="count">{projects.length} projects</span>
    </h2>
    <EntryList entries={workEntries} />
    <a class="more" href="/work/">All work &rarr;</a>
  </section>

  <section id="writing" aria-labelledby="writing-h">
    <h2 id="writing-h" class="eyebrow">
      Writing<span class="rule" aria-hidden="true">/</span><span class="count">{allPosts.length} posts</span>
    </h2>
    <EntryList entries={postEntries} />
    <a class="more" href="/writing/">All writing &rarr;</a>
  </section>

</BaseLayout>

<style>
  .hero { margin-top: var(--space-7); }
  .hero img { border-radius: 18px; }
  .hero .eyebrow { margin-top: var(--space-5); }
  .hero h1 { margin-top: var(--space-2); }
  .tagline {
    margin-top: var(--space-4);
    font-size: var(--t-lead);
    line-height: 1.5;
    max-width: 32rem;
    text-wrap: pretty;
  }
  .intro { margin-top: var(--space-4); color: var(--ink-soft); max-width: 34rem; }

  /* The record: every figure is a link to the evidence behind it. */
  .record {
    list-style: none;
    padding: var(--space-5) 0 0;
    margin-top: var(--space-5);
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-6);
  }
  .record a { text-decoration: none; display: grid; gap: 0.1rem; }
  .record .figure {
    font-family: var(--font-mono);
    font-size: var(--t-figure);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--flag);
    line-height: 1;
  }
  .record .label {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .record a:hover .label { color: var(--ink); }

  section:not(.hero) { margin-top: var(--space-8); }
  section:not(.hero) > .eyebrow { margin-bottom: var(--space-4); }
  .rule { margin-inline: 0.5em; color: var(--line); }
  .more {
    display: inline-block;
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    text-decoration: none;
  }
  .more:hover { text-decoration: underline; }
</style>
