---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EntryList from '../../components/EntryList.astro';
import { postEntry } from '../../lib/entries';

const entries = (await getCollection('writing'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((p) => postEntry(p, true));
---
<BaseLayout
  title="Writing - Yash Raj Pandey"
  description="I write about reproducing new model research and about two competitions I lost. When a claim turns out wrong, I correct the post and mark the change."
  ogImage="/og/page/writing.png"
  ogImageAlt="Writing by Yash Raj Pandey"
>
  <PageHeader
    title="Writing"
    lede="Most of these are reproductions of new model research or post-mortems of two competitions I lost. When a claim turns out wrong, I correct the post and mark the change."
  />
  <div class="wrap">
    <div class="list">
      <EntryList entries={entries} layout="dated" headingLevel={2} />
    </div>
  </div>
</BaseLayout>

<style>
  .list { padding-block: 2.25rem 4rem; border-top: 1px solid var(--line); }
  @media (min-width: 60rem) {
    .list { padding-top: 3rem; }
  }
</style>
