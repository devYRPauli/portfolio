---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { totals, searchUrl, notable, ecosystem } from '../../data/contributions';

const repoUrl = (repo: string) => `https://github.com/${repo}`;
const prUrl = (repo: string) =>
  `https://github.com/${repo}/pulls?q=is%3Apr+author%3AdevYRPauli+is%3Amerged`;
---
<BaseLayout
  title="Open Source - Yash Raj Pandey"
  description="Merged pull requests across llama.cpp, Apple MLX, Google Research's TabFM, RAGFlow, mem0, and litellm. Mostly correctness fixes, each one verifiable."
>
  <PageHeader
    eyebrow={`${totals.merged} merged`}
    title="Open Source"
    lede="Almost all of them are correctness fixes: a parser that drops data, a bill computed at 1/1000 of the real price, a kernel that returns the wrong answer when its input aliases. I find most of them while using the tool for something else."
  />
  <section>
    <p class="verify meta">
      <a href={searchUrl}>See every merged pull request on GitHub</a>. Counts exclude my own
      repositories and student-era merges. Last checked {totals.updated}.
    </p>

    <h2 class="eyebrow">Notable projects</h2>
    <ul class="projects">
      {notable.map((p) => (
        <li>
          <div class="row">
            <a class="repo" href={repoUrl(p.repo)}>{p.repo}</a>
            <a class="count" href={prUrl(p.repo)}>{p.count} merged</a>
          </div>
          <p class="what">{p.what}</p>
          <ul class="highlights">
            {p.highlights.map((h) => <li>{h}</li>)}
          </ul>
        </li>
      ))}
    </ul>

    <h2 class="eyebrow eco-heading">Developer tooling</h2>
    <p class="what eco-intro">
      {ecosystem.count} merged across {ecosystem.repos} repositories in one maintainer's
      ecosystem (<a href={`https://github.com/${ecosystem.owner}`}>{ecosystem.owner}</a>).
      {' '}{ecosystem.what}
    </p>
    <ul class="eco">
      {ecosystem.top.map((r) => (
        <li>
          <a href={prUrl(`${ecosystem.owner}/${r.repo}`)}>{r.repo}</a>
          <span class="n">{r.count}</span>
        </li>
      ))}
      {ecosystem.rest.map((r) => (
        <li>
          <a href={prUrl(`${ecosystem.owner}/${r}`)}>{r}</a>
          <span class="n">1</span>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .verify { margin-bottom: var(--space-7); }
  h2 { margin-bottom: var(--space-4); }
  .eco-heading { margin-top: var(--space-8); }

  .projects { list-style: none; padding: 0; display: grid; gap: var(--space-6); }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
  }
  .repo {
    font-family: var(--font-mono);
    font-size: var(--t-read);
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .repo:hover { color: var(--accent); }
  .count {
    font-family: var(--font-mono);
    color: var(--flag);
    font-size: var(--t-meta);
    white-space: nowrap;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .count:hover { color: var(--accent); }
  .what { color: var(--ink-soft); font-size: var(--t-read); margin-top: var(--space-2); }
  .highlights {
    margin-top: var(--space-3);
    padding-left: 1.1rem;
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .highlights li + li { margin-top: var(--space-1); }

  .eco-intro { margin-bottom: var(--space-4); }
  .eco {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--space-1) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--t-meta);
  }
  .eco li { display: flex; justify-content: space-between; gap: var(--space-2); }
  .eco a { color: var(--ink); text-decoration: none; overflow-wrap: anywhere; }
  .eco a:hover { color: var(--accent); }
  .eco .n { color: var(--ink-soft); font-variant-numeric: tabular-nums; }

  @media (max-width: 520px) {
    .row { flex-direction: column; align-items: flex-start; gap: var(--space-1); }
  }
</style>
