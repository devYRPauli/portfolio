---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ModeSection from '../../components/ModeSection.astro';
import MonthlyMerges from '../../components/MonthlyMerges.astro';
import { totals, searchUrl, notable, others, ecosystem } from '../../data/contributions';

const repoUrl = (repo: string) => `https://github.com/${repo}`;
const prUrl = (repo: string) =>
  `https://github.com/${repo}/pulls?q=is%3Apr+author%3AdevYRPauli+is%3Amerged`;
const tooling = [...ecosystem.top, ...ecosystem.rest.map((repo) => ({ repo, count: 1 }))];
---
<BaseLayout
  title="Open source - Yash Raj Pandey"
  description="These are my merged pull requests to llama.cpp, Apple MLX, Google's TabFM, RAGFlow, LiteLLM and others. Almost all of them are bug fixes."
  ogImage="/og/page/contributions.png"
  ogImageAlt="Open source contributions by Yash Raj Pandey"
>
  <PageHeader
    title="Open source"
    lede="Almost all of these are bug fixes. Most fix code that gave a wrong answer without an error. A RAGFlow parser dropped table cells, and LiteLLM billed Perplexity searches at 1/1000 of the price. The fixes span RAG document parsers, LLM gateways, local inference runtimes, SQL and JavaScript linters, and macOS menu-bar apps."
  >
    <p class="count">
      Since May 2026, <span class="fig">{totals.merged}</span> of my pull requests have been merged across{' '}
      <span class="fig">{totals.projects}</span> open source projects.
    </p>
    <p class="verify">
      <a href={searchUrl}>See every merged pull request on GitHub</a>. Counts exclude my own repositories and
      student-era merges. Last checked <time datetime={totals.updated}>{totals.updated}</time>.
    </p>
  </PageHeader>

  <ModeSection id="by-month" title="By month">
    <MonthlyMerges />
  </ModeSection>

  <ModeSection id="notable" title="Notable projects">
    <ul class="projects">
      {notable.map((p) => (
        <li>
          <div>
            <h3><a href={repoUrl(p.repo)}>{p.repo.split('/')[0]}/<wbr />{p.repo.split('/')[1]}</a></h3>
            <a class="merged" href={prUrl(p.repo)}>{p.count} merged<span class="sr-only"> pull requests in {p.repo}</span></a>
          </div>
          <div>
            <p class="what">{p.what}</p>
            <ul class="highlights">
              {p.highlights.map((h) => <li>{h}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ul>
  </ModeSection>

  {others.length > 0 && (
    <ModeSection id="others" title="Also merged">
      <ul class="tooling">
        {others.map((r) => (
          <li>
            <a href={prUrl(r.repo)}>{r.repo}</a>
            <span class="n">{r.count}</span>
          </li>
        ))}
      </ul>
    </ModeSection>
  )}

  <ModeSection
    id="tooling"
    title="Developer tooling"
    lede={`${ecosystem.count} merged across ${ecosystem.repos} repositories in one maintainer's ecosystem. ${ecosystem.what}`}
    more={{ href: `https://github.com/${ecosystem.owner}`, label: `${ecosystem.owner} on GitHub` }}
    band
  >
    <ul class="tooling">
      {tooling.map((r) => (
        <li>
          <a href={prUrl(`${ecosystem.owner}/${r.repo}`)}>{r.repo}</a>
          <span class="n">{r.count}</span>
        </li>
      ))}
    </ul>
  </ModeSection>
</BaseLayout>

<style>
  .count { margin-top: 1.25rem; font-size: var(--t-md); max-width: 40rem; }
  .verify { margin-top: 0.6rem; font-size: var(--t-ui); color: var(--ink-soft); max-width: 40rem; }

  .projects { list-style: none; }
  .projects > li { display: grid; gap: 0.3rem 2rem; padding-block: 1.25rem; border-top: 1px solid var(--line); }
  .projects > li:first-child { padding-top: 0.2rem; border-top: 0; }
  h3 { font-size: var(--t-base); font-weight: 650; line-height: 1.3; }
  h3 a { color: var(--ink); text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent); }
  h3 a:hover { color: var(--accent); }
  .merged { display: inline-block; margin-top: 0.2rem; font-size: var(--t-sm); font-variant-numeric: tabular-nums; }
  .what { font-size: var(--t-ui); color: var(--ink-soft); line-height: 1.5; }
  .highlights { margin-top: 0.6rem; padding-left: 1.1rem; font-size: var(--t-sm); line-height: 1.5; color: var(--ink-soft); }
  .highlights li + li { margin-top: 0.25rem; }
  .highlights li::marker { color: var(--ink-soft); }
  @media (min-width: 40rem) {
    .projects > li { grid-template-columns: 12.5rem minmax(0, 1fr); }
  }

  .tooling {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: 0.35rem 2rem;
    font-size: var(--t-ui);
  }
  .tooling li { display: flex; justify-content: space-between; gap: 0.5rem; padding-block: 0.3rem; border-bottom: 1px solid var(--line); }
  .tooling a { color: var(--ink); overflow-wrap: anywhere; }
  .tooling a:hover { color: var(--accent); }
  .n { color: var(--ink-soft); font-variant-numeric: tabular-nums; }
</style>
