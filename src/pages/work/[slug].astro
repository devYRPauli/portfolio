---
import { getCollection, getEntry, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { modes } from '../../lib/modes';
import { getWriteups, workHref } from '../../lib/entries';

export async function getStaticPaths() {
  const projects = await getCollection('work');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const writeups = await getWriteups();
// A project with a writeup lives at the post. This page only keeps old links working.
const writeup = writeups.get(project.id);
if (writeup) return Astro.redirect(`/writing/${writeup.id}/`, 301);

const { Content } = await render(project);
const { role, kind, year, stack, links = [], mode, supersededBy } = project.data;
const successor = supersededBy ? await getEntry(supersededBy) : undefined;

const railLinks = [
  ...links,
  ...(successor ? [{ href: workHref(successor.id, writeups), label: `Superseded by ${successor.data.title}` }] : []),
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.data.title,
  description: project.data.summary,
  url: new URL(`/work/${project.id}/`, Astro.site).href,
  image: new URL(`/og/work/${project.id}.png`, Astro.site).href,
  dateCreated: year.slice(0, 4),
  keywords: stack,
  creator: { '@type': 'Person', name: 'Yash Raj Pandey', url: 'https://yashrajpandey.com' },
};
---
<PostLayout
  title={project.data.title}
  description={project.data.summary}
  crumb={{ href: `/work/#${mode}`, label: modes[mode].label }}
  verdict={project.data.verdict}
  facts={[
    { label: 'Role', value: role },
    { label: 'Kind', value: `${kind}, ${year}` },
    { label: 'Stack', value: stack.join(', ') },
  ]}
  links={railLinks}
  more={[{ href: '/work/', label: 'More work' }]}
  ogImage={`/og/work/${project.id}.png`}
  jsonLd={jsonLd}
  transitionName={`work-${project.id}`}
  railLabel="About this project"
>
  <Content />
</PostLayout>
