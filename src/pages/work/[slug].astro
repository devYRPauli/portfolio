---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('work');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { role, year, stack, links } = project.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.data.title,
  description: project.data.summary,
  url: new URL(`/work/${project.id}/`, Astro.site).href,
  image: new URL(`/og/work/${project.id}.png`, Astro.site).href,
  dateCreated: year.slice(0, 4),
  keywords: stack,
  creator: { '@type': 'Person', name: 'Yash Raj Pandey', url: 'https://yashrajpandey.com' },
};
---
<PostLayout
  title={project.data.title}
  description={project.data.summary}
  metaParts={[role, year]}
  ogImage={`/og/work/${project.id}.png`}
  jsonLd={jsonLd}
  transitionName={`work-${project.id}`}
  backHref="/work/"
  backLabel="Work"
>
  <p class="stack">
    {stack.map((s) => <span>{s}</span>)}
  </p>
  {links && (
    <p class="links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </p>
  )}
  <Content />
</PostLayout>

<style>
  .stack { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .links { display: flex; flex-wrap: wrap; gap: 1rem; }
  .stack span {
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.1rem 0.5rem;
    color: var(--ink-soft);
  }
</style>
