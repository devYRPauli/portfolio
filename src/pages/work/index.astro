---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ModeSection from '../../components/ModeSection.astro';
import EntryList from '../../components/EntryList.astro';
import { modes, type Mode } from '../../lib/modes';
import { workEntry, byOrder, getWriteups } from '../../lib/entries';

const work = await getCollection('work');
const writeups = await getWriteups();

const inMode = (mode: Mode, withLinks = false) =>
  work
    .filter((p) => p.data.mode === mode)
    .sort(byOrder)
    .map((p) => workEntry(p, work, writeups, withLinks));
---
<BaseLayout
  title="Work - Yash Raj Pandey"
  description="These are the projects I have built and tested, from a genomics platform at UF to a tool-calling matrix for local model servers. Two are about football."
  ogImage="/og/page/work.png"
  ogImageAlt="Work by Yash Raj Pandey"
>
  <PageHeader
    title="Work"
    lede="This is what I have built and tested, at UF and on my own time. Each page covers the trade-offs, including the parts that did not go smoothly."
  />
  <ModeSection id="build" title={modes.build.label} lede={modes.build.lede}>
    <EntryList entries={inMode('build')} layout="spec" />
  </ModeSection>
  <ModeSection id="evaluate" title={modes.evaluate.label} lede={modes.evaluate.lede}>
    <EntryList entries={inMode('evaluate')} layout="result" />
  </ModeSection>
  <ModeSection id="football" title={modes.football.label} lede={modes.football.lede} band>
    <EntryList entries={inMode('football', true)} layout="pair" />
  </ModeSection>
</BaseLayout>
