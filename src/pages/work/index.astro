---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EntryList from '../../components/EntryList.astro';

const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

const toEntry = (p: (typeof projects)[number]) => ({
  href: `/work/${p.id}/`,
  title: p.data.title,
  meta: [p.data.kind, p.data.year],
  summary: p.data.summary,
  transitionName: `work-${p.id}`,
});

const selected = projects.slice(0, 6).map(toEntry);
const more = projects.slice(6).map(toEntry);
---
<BaseLayout
  title="Work - Yash Raj Pandey"
  description="Selected AI systems, model evaluations, developer tools, and products built by Yash Raj Pandey."
  ogImage="/og/page/work.png"
  ogImageAlt="Work by Yash Raj Pandey"
>
  <PageHeader
    eyebrow={`${projects.length} projects`}
    title="Work"
    lede="Systems, tools, and independent evaluations I have built and shipped. Each page covers the problem, the decisions, the result, and the parts that did not go smoothly."
  />
  <EntryList entries={selected} />

  {more.length > 0 && (
    <section class="more">
      <h2 class="eyebrow">More</h2>
      <EntryList entries={more} />
    </section>
  )}
</BaseLayout>

<style>
  .more { margin-top: var(--space-8); }
  .more h2 { margin-bottom: var(--space-4); }
</style>
