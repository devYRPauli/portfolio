---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkList from '../../components/WorkList.astro';

const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const selected = projects.slice(0, 6);
const more = projects.slice(6);
---
<BaseLayout
  title="Work - Yash Raj Pandey"
  description="Selected AI systems, model evaluations, developer tools, and products built by Yash Raj Pandey."
>
  <section>
    <a class="back" href="/">&larr; Home</a>
    <h1>Work</h1>
    <p class="intro">Systems, tools, and independent evaluations I have built and shipped. Each page covers the problem, the decisions, the result, and the parts that did not go smoothly.</p>

    <h2 class="section-label">Selected</h2>
    <WorkList projects={selected} />

    {more.length > 0 && (
      <>
        <h2 class="section-label more-heading">More Projects</h2>
        <WorkList projects={more} />
      </>
    )}
  </section>
</BaseLayout>

<style>
  section { margin-top: 3rem; }
  h1 { margin-bottom: 0.75rem; }
  .intro { color: var(--ink-soft); margin-bottom: 2rem; }
  .section-label { margin-bottom: 0.75rem; }
  .more-heading { margin-top: 2.5rem; }
</style>
