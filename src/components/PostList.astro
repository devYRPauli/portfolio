---
import type { CollectionEntry } from 'astro:content';

interface Props { posts: CollectionEntry<'writing'>[] }
const { posts } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<ul>
  {posts.map((p) => (
    <li>
      <a href={`/writing/${p.id}/`}>
        <span class="row">
          <strong transition:name={`post-${p.id}`}>{p.data.title}</strong>
          <time class="numeric" datetime={p.data.pubDate.toISOString()}>{fmt(p.data.pubDate)}</time>
        </span>
        <span class="summary">{p.data.description}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  ul { list-style: none; padding: 0; display: grid; gap: var(--space-1); }
  a {
    display: block;
    padding: var(--space-3) var(--space-4);
    margin-inline: calc(-1 * var(--space-4));
    border-radius: 10px;
    text-decoration: none;
    color: var(--ink);
  }
  a:hover { background: var(--bg-raised); }
  .row { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4); }
  time { color: var(--ink-soft); font-size: 0.875rem; white-space: nowrap; }
  .summary { color: var(--ink-soft); font-size: 0.9375rem; }
  @media (max-width: 520px) {
    .row { align-items: flex-start; }
    time { margin-top: 0.15rem; }
  }
</style>
