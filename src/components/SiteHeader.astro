---
const nav = [
  { href: '/work/', label: 'Work' },
  { href: '/writing/', label: 'Writing' },
  { href: '/contributions/', label: 'Open source' },
  { href: '/about/', label: 'About' },
];

const path = Astro.url.pathname;
/** "page" on the section index itself, "true" anywhere below it. */
const current = (href: string) => (path === href ? 'page' : path.startsWith(href) ? 'true' : undefined);
---
<header>
  <div class="wrap bar">
    <a class="brand" href="/">Yash Raj Pandey</a>
    <nav aria-label="Main">
      {nav.map((item) => (
        <a href={item.href} aria-current={current(item.href)}>{item.label}</a>
      ))}
    </nav>
    <button id="theme-toggle" type="button" aria-label="Dark theme" aria-pressed="false">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.6" />
        <path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor" />
      </svg>
    </button>
  </div>
</header>

<style>
  header { border-bottom: 1px solid var(--line); }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'brand toggle' 'nav nav';
    align-items: center;
    gap: 0.25rem 1rem;
    padding-block: 0.85rem;
  }
  .brand {
    grid-area: brand;
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
    font-variation-settings: 'GEOM' 50;
  }
  .brand:hover { color: var(--accent); }
  nav {
    grid-area: nav;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }
  nav a {
    display: flex;
    align-items: center;
    min-height: 2.25rem;
    color: var(--ink-soft);
    text-decoration: none;
    font-size: var(--t-ui);
  }
  nav a:hover { color: var(--ink); text-decoration: underline; text-decoration-color: var(--accent); }
  nav a[aria-current] { color: var(--accent); text-decoration: underline; }
  button {
    grid-area: toggle;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-right: -0.4rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }
  button:hover { background: var(--bg-raised); }
  @media (min-width: 48rem) {
    .bar {
      grid-template-columns: 1fr auto auto;
      grid-template-areas: 'brand nav toggle';
      gap: 1.75rem;
    }
    nav { gap: 1.5rem; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const button = document.getElementById('theme-toggle');
    const root = document.documentElement;
    const sync = () => button?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
    sync();
    button?.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      // Picking the system's own theme goes back to following the system.
      const system = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      if (next === system) localStorage.removeItem('theme');
      else localStorage.setItem('theme', next);
      sync();
    });
  });
</script>
