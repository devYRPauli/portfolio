---
const nav = [
  { href: '/work/', label: 'Work' },
  { href: '/writing/', label: 'Writing' },
  { href: '/contributions/', label: 'Open Source' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  (href === '/writing/' && path.startsWith('/writing')) ||
  (href === '/work/' && path.startsWith('/work')) ||
  (href === '/contributions/' && path.startsWith('/contributions'));
---
<header>
  <div class="container bar">
    <a class="brand" href="/">Yash Raj Pandey</a>
    <nav class="main-nav" aria-label="Main">
      {nav.map((item) => (
        <a class="nav-link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <a class="icon-link" href="https://github.com/devYRPauli" aria-label="GitHub profile" rel="me">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.58 2 12.24c0 4.52 2.87 8.36 6.84 9.72.5.1.68-.22.68-.49 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.21-3.37-1.21-.46-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.66.35-1.12.64-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.98a9.3 9.3 0 0 1 2.5.35c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10.25 10.25 0 0 0 22 12.24C22 6.58 17.52 2 12 2Z" />
        </svg>
      </a>
      <a class="icon-link" href="https://www.linkedin.com/in/yashrajpandeyy/" aria-label="LinkedIn profile" rel="me">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.5 8.4H3.2V21h3.3V8.4ZM4.85 3A1.9 1.9 0 1 0 4.85 6.8 1.9 1.9 0 0 0 4.85 3ZM21 13.78c0-3.8-2.03-5.57-4.74-5.57-2.18 0-3.16 1.2-3.7 2.04V8.4H9.27V21h3.3v-6.24c0-1.64.3-3.23 2.34-3.23 2 0 2.03 1.87 2.03 3.34V21H21v-7.22Z" />
        </svg>
      </a>
      <a class="icon-link" href="https://x.com/I_AM_YRP" aria-label="X profile" rel="me">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.9 2H22l-6.78 7.75L23.2 22h-6.25l-4.9-6.4L6.46 22H3.34l7.25-8.29L2.93 2h6.4l4.42 5.84L18.9 2Zm-1.1 17.84h1.72L8.39 4.05H6.54L17.8 19.84Z" />
        </svg>
      </a>
      <button id="theme-toggle" type="button" aria-label="Toggle color theme">
        <svg class="sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4" />
        </svg>
        <svg class="moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  header { border-bottom: 1px solid var(--line); }
  .bar {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-3);
  }
  .brand { font-weight: 600; color: var(--ink); text-decoration: none; }
  .main-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-1) var(--space-4);
  }
  .nav-link {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.9375rem;
  }
  .nav-link:hover { color: var(--ink); }
  .nav-link[aria-current='page'] { color: var(--ink); }
  .icon-link,
  button {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 8px;
    color: var(--ink-soft);
  }
  .icon-link { text-decoration: none; }
  .icon-link:hover { color: var(--ink); background: var(--bg-raised); }
  @media (max-width: 640px) {
    .bar { grid-template-columns: 1fr; padding-block: var(--space-3); gap: var(--space-2); }
    .brand { font-size: 0.9375rem; white-space: nowrap; }
    .main-nav { grid-row: 2; justify-content: flex-start; gap: 0 var(--space-3); }
    .nav-link { display: flex; align-items: center; min-height: 2.5rem; font-size: 0.9375rem; }
  }
  button {
    background: none;
    border: 1px solid var(--line);
    cursor: pointer;
  }
  button:hover { color: var(--ink); border-color: var(--ink-soft); }
  :global(html[data-theme='dark']) .moon { display: none; }
  :global(html:not([data-theme='dark'])) .sun { display: none; }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const button = document.getElementById('theme-toggle');
    const syncButton = () => {
      const isDark = document.documentElement.dataset.theme === 'dark';
      button?.setAttribute('aria-pressed', String(isDark));
      button?.setAttribute('aria-label', isDark ? 'Use light theme' : 'Use dark theme');
    };
    syncButton();
    button?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
      syncButton();
    });
  });
</script>
