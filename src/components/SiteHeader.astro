---
const nav = [
  { href: '/work/', label: 'Work' },
  { href: '/writing/', label: 'Writing' },
  { href: '/contributions/', label: 'Open Source' },
  { href: '/about/', label: 'About' },
];

const path = Astro.url.pathname;
/** A nav item is current when the URL sits at or below its section. */
const isCurrent = (href: string) => path === href || path.startsWith(href);
---
<header>
  <div class="container bar">
    <a class="brand" href="/">Yash Raj Pandey</a>
    <nav class="main-nav" aria-label="Main">
      {nav.map((item) => (
        <a class="nav-link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <button id="theme-toggle" type="button" aria-label="Toggle color theme">
        <svg class="sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4" />
        </svg>
        <svg class="moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  header { border-bottom: 1px solid var(--line); }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--space-4);
  }
  .brand { font-weight: 600; color: var(--ink); text-decoration: none; letter-spacing: -0.01em; }
  .brand:hover { color: var(--accent); }
  .main-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-1) var(--space-5);
  }
  .nav-link {
    color: var(--ink-soft);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    letter-spacing: 0.02em;
  }
  .nav-link:hover { color: var(--ink); }
  .nav-link[aria-current='page'] { color: var(--ink); }
  button {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    color: var(--ink-soft);
    background: none;
    border: 1px solid var(--line);
    cursor: pointer;
  }
  button:hover { color: var(--ink); border-color: var(--ink-soft); }
  @media (max-width: 560px) {
    .bar { flex-direction: column; align-items: flex-start; gap: var(--space-2); padding-block: var(--space-3); }
    .main-nav { justify-content: flex-start; gap: 0 var(--space-4); width: 100%; }
    .nav-link { display: flex; align-items: center; min-height: 2.25rem; }
  }
  :global(html[data-theme='dark']) .moon { display: none; }
  :global(html:not([data-theme='dark'])) .sun { display: none; }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const button = document.getElementById('theme-toggle');
    const syncButton = () => {
      const isDark = document.documentElement.dataset.theme === 'dark';
      button?.setAttribute('aria-pressed', String(isDark));
      button?.setAttribute('aria-label', isDark ? 'Use light theme' : 'Use dark theme');
    };
    syncButton();
    button?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
      syncButton();
    });
  });
</script>
