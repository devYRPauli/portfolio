---
interface Props {
  title: string;
  lede?: string;
}
const { title, lede } = Astro.props;
---
<header class="wrap">
  <h1>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
  <slot />
</header>

<style>
  header { padding-block: 2.5rem 2.25rem; }
  h1 { font-size: var(--t-title); line-height: 1.05; }
  .lede { margin-top: 1.1rem; font-size: var(--t-md); line-height: 1.45; color: var(--ink-soft); max-width: 40rem; }
  @media (min-width: 60rem) {
    header { padding-block: 3.5rem 2.75rem; }
  }
</style>
