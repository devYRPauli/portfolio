---
const year = new Date().getFullYear();
---
<footer>
  <div class="container row">
    <span>(c) {year} Yash Raj Pandey</span>
    <nav class="links" aria-label="Footer">
      <a href="/Resume_YashRaj.pdf">Resume</a>
      <a href="mailto:yashpn62@gmail.com">Email</a>
      <a href="/rss.xml">RSS</a>
    </nav>
  </div>
  <div class="container">
    <p class="colophon">Built with Astro. No client framework.</p>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--line); margin-top: var(--space-8); }
  .row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-5) var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    color: var(--ink-soft);
  }
  .links { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--space-1) var(--space-4); }
  a { color: var(--ink-soft); text-decoration: none; }
  a:hover { color: var(--accent); text-decoration: underline; }
  .colophon {
    padding-bottom: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  @media (max-width: 600px) {
    .row { flex-direction: column; }
    .links { justify-content: flex-start; }
  }
</style>
