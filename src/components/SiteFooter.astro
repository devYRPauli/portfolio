---
const year = new Date().getFullYear();

const social = [
  {
    href: 'https://github.com/devYRPauli',
    label: 'GitHub',
    path: 'M12 2C6.48 2 2 6.58 2 12.24c0 4.52 2.87 8.36 6.84 9.72.5.1.68-.22.68-.49 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.21-3.37-1.21-.46-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.66.35-1.12.64-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.98a9.3 9.3 0 0 1 2.5.35c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10.25 10.25 0 0 0 22 12.24C22 6.58 17.52 2 12 2Z',
  },
  {
    href: 'https://www.linkedin.com/in/yashrajpandeyy/',
    label: 'LinkedIn',
    path: 'M6.5 8.4H3.2V21h3.3V8.4ZM4.85 3A1.9 1.9 0 1 0 4.85 6.8 1.9 1.9 0 0 0 4.85 3ZM21 13.78c0-3.8-2.03-5.57-4.74-5.57-2.18 0-3.16 1.2-3.7 2.04V8.4H9.27V21h3.3v-6.24c0-1.64.3-3.23 2.34-3.23 2 0 2.03 1.87 2.03 3.34V21H21v-7.22Z',
  },
  {
    href: 'https://x.com/devYRPauli',
    label: 'X',
    path: 'M18.9 2H22l-6.78 7.75L23.2 22h-6.25l-4.9-6.4L6.46 22H3.34l7.25-8.29L2.93 2h6.4l4.42 5.84L18.9 2Z',
  },
];

const links = [
  { href: '/Resume_YashRaj.pdf', label: 'Resume' },
  { href: 'mailto:yashpn62@gmail.com', label: 'Email' },
  { href: '/rss.xml', label: 'RSS' },
];
---
<footer>
  <div class="container inner">
    <div class="top">
      <div class="who">
        <p class="name">Yash Raj Pandey</p>
        <p class="where">Gainesville, Florida</p>
      </div>
      <nav class="social" aria-label="Elsewhere">
        {social.map((s) => (
          <a href={s.href} aria-label={s.label} rel="me">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={s.path} />
            </svg>
          </a>
        ))}
      </nav>
    </div>

    <nav class="links" aria-label="Footer">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <p class="colophon">
      <span>(c) {year}</span>
      <span>Built with Astro. No client framework.</span>
    </p>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--line); margin-top: var(--space-8); }
  .inner { padding-block: var(--space-6) var(--space-5); }

  .top { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-5); }
  .name { font-weight: 600; letter-spacing: -0.01em; }
  .where {
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    color: var(--ink-soft);
    margin-top: 0.15rem;
  }

  .social { display: flex; gap: var(--space-1); }
  .social a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 8px;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .social a:hover { color: var(--ink); background: var(--bg-raised); }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin-top: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--t-meta);
  }
  .links a { color: var(--ink-soft); text-decoration: none; }
  .links a:hover { color: var(--accent); text-decoration: underline; }

  .colophon {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  @media (max-width: 520px) {
    .top { flex-direction: column; gap: var(--space-4); }
    .social { margin-left: calc(-1 * var(--space-2)); }
  }
</style>
