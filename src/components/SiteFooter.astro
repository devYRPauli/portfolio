---
const links = [
  { href: 'https://github.com/devYRPauli', label: 'GitHub', rel: 'me' },
  { href: 'https://www.linkedin.com/in/yashrajpandeyy/', label: 'LinkedIn', rel: 'me' },
  { href: 'https://x.com/devYRPauli', label: 'X', rel: 'me' },
  { href: 'mailto:yashpn62@gmail.com', label: 'Email' },
  { href: '/Resume_YashRaj.pdf', label: 'Resume' },
  { href: '/rss.xml', label: 'RSS' },
];
---
<footer>
  <div class="wrap grid">
    <div>
      <p class="name">Yash Raj Pandey</p>
      <p class="soft">Gainesville, Florida</p>
    </div>
    <ul>
      {links.map((l) => <li><a href={l.href} rel={l.rel}>{l.label}</a></li>)}
    </ul>
    <p class="soft colophon">Built with Astro. The pull request counts refresh from GitHub every week.</p>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--line); }
  .grid {
    display: grid;
    gap: 1.25rem 2rem;
    padding-block: 2.5rem 3rem;
    font-size: var(--t-ui);
  }
  .name { font-weight: 650; }
  .soft { color: var(--ink-soft); }
  ul { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem 1.4rem; }
  @media (min-width: 48rem) {
    .grid { grid-template-columns: 1fr auto; align-items: start; }
    .colophon { grid-column: 1 / -1; padding-top: 1.25rem; border-top: 1px solid var(--line); }
  }
</style>
