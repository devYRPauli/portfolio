---
import type { CollectionEntry } from 'astro:content';

interface Props { projects: CollectionEntry<'work'>[] }
const { projects } = Astro.props;
---
<ul>
  {projects.map((p) => (
    <li>
      <a href={`/work/${p.id}/`}>
        <span class="row">
          <strong transition:name={`work-${p.id}`}>{p.data.title}</strong>
          <span class="kind">{p.data.kind}</span>
        </span>
        <span class="summary">{p.data.summary}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  ul { list-style: none; padding: 0; display: grid; gap: var(--space-1); }
  a {
    display: block;
    padding: var(--space-3) var(--space-4);
    margin-inline: calc(-1 * var(--space-4));
    border-radius: 10px;
    text-decoration: none;
    color: var(--ink);
  }
  a:hover { background: var(--bg-raised); }
  .row { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4); }
  .kind { color: var(--ink-soft); font-size: 0.8125rem; white-space: nowrap; }
  .summary { color: var(--ink-soft); font-size: 0.9375rem; }
  @media (max-width: 520px) {
    li { min-width: 0; }
    .row { flex-direction: column; align-items: flex-start; gap: 0; }
    .kind { margin-top: 0.15rem; white-space: normal; }
  }
</style>
