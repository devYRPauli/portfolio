---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date?: Date;
  updated?: Date;
  meta?: string;
  jsonLd?: object;
  transitionName?: string;
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  description,
  date,
  updated,
  meta,
  jsonLd,
  transitionName,
  backHref = '/',
  backLabel = 'Home',
} = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="progress" aria-hidden="true"></div>
  <article>
    <header>
      <a class="back" href={backHref}>&larr; {backLabel}</a>
      <h1 transition:name={transitionName}>{title}</h1>
      <p class="byline">
        {date && <time class="numeric" datetime={date.toISOString()}>{fmt(date)}</time>}
        {updated && <span> (updated {fmt(updated)})</span>}
        {meta && <span>{meta}</span>}
      </p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>

  <script>
    const onScroll = () => {
      const bar = document.querySelector('.progress');
      if (!(bar instanceof HTMLElement)) return;
      const el = document.documentElement;
      const max = el.scrollHeight - el.clientHeight;
      bar.style.transform = `scaleX(${max > 0 ? el.scrollTop / max : 0})`;
    };
    addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:page-load', onScroll);
  </script>
</BaseLayout>

<style>
  article { margin-top: 3rem; }
  header { margin-bottom: 2.5rem; }
  .back {
    display: inline-block;
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.9375rem;
    margin-bottom: 1.25rem;
  }
  .back:hover { color: var(--ink); }
  .byline {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    margin-top: 0.75rem;
    display: flex;
    gap: 0.75rem;
  }
</style>
