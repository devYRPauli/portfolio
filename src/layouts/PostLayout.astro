---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Verdict from '../components/Verdict.astro';
import { isoDate } from '../lib/reading';

type Link = { href: string; label: string };

interface Props {
  title: string;
  description: string;
  /** Where this page sits: Writing for posts, the mode for case studies. */
  crumb: Link;
  verdict?: { tried: string; result: string };
  /** Short facts for the rail. A Date renders as an ISO date. */
  facts: { label: string; value: string | Date }[];
  links?: Link[];
  headings?: MarkdownHeading[];
  /** Links under the body, to the next place to go. */
  more: Link[];
  date?: Date;
  updated?: Date;
  tags?: string[];
  ogImage?: string;
  jsonLd?: object;
  transitionName?: string;
  railLabel: string;
}

const {
  title,
  description,
  crumb,
  verdict,
  facts,
  links = [],
  headings = [],
  more,
  date,
  updated,
  tags,
  ogImage,
  jsonLd,
  transitionName,
  railLabel,
} = Astro.props;

// A contents list only helps once there is something to skip past.
const toc = headings.filter((h) => h.depth === 2);
const showToc = toc.length >= 3;
---
<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogImageAlt={`${title} by Yash Raj Pandey`}
  jsonLd={jsonLd}
  ogType={date ? 'article' : 'website'}
  publishedTime={date}
  modifiedTime={updated}
  tags={tags}
>
  <div class="progress" aria-hidden="true"></div>
  <article class="wrap">
    <header>
      <a class="crumb" href={crumb.href}>{crumb.label}</a>
      <h1 transition:name={transitionName}>{title}</h1>
      <p class="desc">{description}</p>
      {verdict && <Verdict verdict={verdict} class="lead" />}
    </header>

    <div class="grid">
      <aside class="post-rail" aria-label={railLabel}>
        <dl>
          {facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value instanceof Date ? <time datetime={f.value.toISOString()}>{isoDate(f.value)}</time> : f.value}</dd>
            </div>
          ))}
        </dl>
        {links.length > 0 && (
          <ul class="links">
            {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        )}
        {showToc && (
          <nav class="toc" aria-labelledby="toc-h">
            <h2 id="toc-h">Contents</h2>
            <ol>
              {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ol>
          </nav>
        )}
      </aside>
      <div class="prose">
        <slot />
      </div>
    </div>

    <p class="end">{more.map((l) => <a href={l.href}>{l.label}</a>)}</p>
  </article>

  <script>
    const onScroll = () => {
      const bar = document.querySelector('.progress');
      if (!(bar instanceof HTMLElement)) return;
      const el = document.documentElement;
      const max = el.scrollHeight - el.clientHeight;
      bar.style.transform = `scaleX(${max > 0 ? el.scrollTop / max : 0})`;
    };
    addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:page-load', onScroll);

    const addCopyButtons = () => {
      document.querySelectorAll('.prose pre').forEach((pre) => {
        if (pre.querySelector('.copy-btn')) return;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'copy-btn';
        btn.textContent = 'Copy';
        btn.addEventListener('click', async () => {
          let timeout: number | undefined;
          btn.textContent = 'Copying';
          try {
            await Promise.race([
              navigator.clipboard.writeText(pre.querySelector('code')?.textContent ?? ''),
              new Promise<never>((_, reject) => {
                timeout = window.setTimeout(() => reject(new Error('Clipboard write timed out')), 2000);
              }),
            ]);
            btn.textContent = 'Copied';
          } catch {
            btn.textContent = 'Copy failed';
          } finally {
            if (timeout !== undefined) window.clearTimeout(timeout);
          }
          setTimeout(() => {
            btn.textContent = 'Copy';
          }, 1500);
        });
        pre.appendChild(btn);
      });
    };
    document.addEventListener('astro:page-load', addCopyButtons);
  </script>
</BaseLayout>

<style>
  header { padding-block: 2.5rem 2.25rem; }
  .crumb {
    font-size: var(--t-ui);
    color: var(--ink);
    text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .crumb:hover { color: var(--accent); }
  h1 { margin-top: 1.25rem; font-size: var(--t-title); line-height: 1.05; max-width: 24ch; }
  .desc { margin-top: 1.1rem; font-size: var(--t-md); line-height: 1.45; color: var(--ink-soft); max-width: 40rem; }
  header :global(.verdict.lead) { margin-top: 1.4rem; font-size: var(--t-lg); line-height: 1.3; }

  .grid { display: grid; gap: 2rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .post-rail { font-size: var(--t-sm); color: var(--ink-soft); }
  dl { display: flex; flex-wrap: wrap; gap: 0.75rem 1.75rem; }
  dd { color: var(--ink); }
  .links { list-style: none; margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; }
  .toc { display: none; }

  .end {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 3.5rem;
    padding-block: 1.5rem 4rem;
    border-top: 1px solid var(--line);
    font-size: var(--t-ui);
  }

  @media (min-width: 60rem) {
    header { padding-block: 3.5rem 2.75rem; }
    .grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 2rem; padding-top: 3rem; }
    .post-rail {
      grid-column: 1 / span 3;
      position: sticky;
      top: 1.5rem;
      align-self: start;
      max-height: calc(100dvh - 3rem);
      overflow-y: auto;
      /* Room for focus outlines, which overflow would otherwise clip. */
      padding: 0.35rem;
      margin: -0.35rem;
    }
    .prose { grid-column: 4 / span 9; }
    dl { display: grid; gap: 0.6rem; }
    .links { display: grid; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line); }
    .toc { display: block; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line); }
    .toc h2 { font-size: var(--t-sm); font-weight: 650; color: var(--ink); font-variation-settings: normal; }
    .toc ol { list-style: none; margin-top: 0.6rem; display: grid; gap: 0.45rem; }
    .toc a { display: block; color: var(--ink-soft); text-decoration: none; line-height: 1.35; }
    .toc a:hover { color: var(--accent); text-decoration: underline; }
  }
</style>
