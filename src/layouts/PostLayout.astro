---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date?: Date;
  updated?: Date;
  tags?: string[];
  /** Measured facts for the byline, rendered in the mono voice. */
  metaParts?: string[];
  ogImage?: string;
  jsonLd?: object;
  transitionName?: string;
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  description,
  date,
  updated,
  tags,
  metaParts = [],
  ogImage,
  jsonLd,
  transitionName,
  backHref = '/',
  backLabel = 'Home',
} = Astro.props;

const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogImageAlt={`${title} by Yash Raj Pandey`}
  jsonLd={jsonLd}
  ogType={date ? 'article' : 'website'}
  publishedTime={date}
  modifiedTime={updated}
  tags={tags}
>
  <div class="progress" aria-hidden="true"></div>
  <article>
    <header>
      <a class="back" href={backHref}>&larr; {backLabel}</a>
      <p class="eyebrow">{backLabel}</p>
      <h1 transition:name={transitionName}>{title}</h1>
      <p class="byline meta">
        {date && <time datetime={date.toISOString()}>{fmt(date)}</time>}
        {metaParts.map((m) => <span>{m}</span>)}
        {updated && <span class="updated">updated {fmt(updated)}</span>}
      </p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>

  <script>
    const onScroll = () => {
      const bar = document.querySelector('.progress');
      if (!(bar instanceof HTMLElement)) return;
      const el = document.documentElement;
      const max = el.scrollHeight - el.clientHeight;
      bar.style.transform = `scaleX(${max > 0 ? el.scrollTop / max : 0})`;
    };
    addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:page-load', onScroll);

    const addCopyButtons = () => {
      document.querySelectorAll('.prose pre').forEach((pre) => {
        if (pre.querySelector('.copy-btn')) return;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'copy-btn';
        btn.textContent = 'Copy';
        btn.addEventListener('click', async () => {
          let timeout: number | undefined;
          btn.textContent = 'Copying';
          try {
            await Promise.race([
              navigator.clipboard.writeText(pre.querySelector('code')?.textContent ?? ''),
              new Promise<never>((_, reject) => {
                timeout = window.setTimeout(() => reject(new Error('Clipboard write timed out')), 2000);
              }),
            ]);
            btn.textContent = 'Copied';
          } catch {
            btn.textContent = 'Copy failed';
          } finally {
            if (timeout !== undefined) window.clearTimeout(timeout);
          }
          setTimeout(() => {
            btn.textContent = 'Copy';
          }, 1500);
        });
        pre.appendChild(btn);
      });
    };
    document.addEventListener('astro:page-load', addCopyButtons);
  </script>
</BaseLayout>

<style>
  article { margin-top: var(--space-7); }
  header { margin-bottom: var(--space-7); }
  .eyebrow { margin-top: var(--space-5); }
  h1 { margin-top: var(--space-3); }
  .byline {
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
  }
  /* The one place amber means something other than a measured value:
     a post that has been corrected or updated after publishing. */
  .updated {
    color: var(--flag);
    font-weight: 500;
  }
</style>
